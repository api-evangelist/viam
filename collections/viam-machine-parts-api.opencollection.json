              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Schedule a restart for a machine part."
        },
        {
          "info": {
            "name": "Viam Get Machine Part Logs",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.viam.com/viam.app.v1.AppService/GetRobotPartLogs",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieve logs from a machine part."

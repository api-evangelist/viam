{
  "opencollection": "1.0.0",
  "info": {
    "name": "Viam Billing Arm Modules API",
    "version": "2026.05"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Modules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Viam Get Models From Modules",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.viam.com/viam.robot.v1.RobotService/GetModelsFromModules",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieve the list of resource models registered by all loaded modules."
        },
        {
          "info": {
            "name": "Viam Restart Module",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.viam.com/viam.robot.v1.RobotService/RestartModule",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Restart a loaded module without restarting viam-server."
        }
      ]
    }
  ],
  "bundled": true
}
{
  "opencollection": "1.0.0",
  "info": {
    "name": "Viam Billing Arm Sessions API",
    "version": "2026.05"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sessions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Viam Start Session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.viam.com/viam.robot.v1.RobotService/StartSession",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Open a new session with the machine."
        },
        {
          "info": {
            "name": "Viam Send Session Heartbeat",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.viam.com/viam.robot.v1.RobotService/SendSessionHeartbeat",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Send a heartbeat to keep the session alive."
        },
        {
          "info": {
            "name": "Viam Get Sessions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.viam.com/viam.robot.v1.RobotService/GetSessions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "List active sessions on the machine."
        }
      ]
    }
  ],
  "bundled": true
}
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Register a new OAuth application against an organization."
        },
        {
          "info": {
            "name": "Viam List Oauth Apps",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.viam.com/viam.app.v1.AppService/ListOAuthApps",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "List OAuth applications registered under an organization."
        }
      ]
    }
  ],
  "bundled": true
}
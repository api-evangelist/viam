{
  "opencollection": "1.0.0",
  "info": {
    "name": "Viam Billing Arm OAuth Apps API",
    "version": "2026.05"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "OAuth Apps",
        "type": "folder"
      },
      "items": [
        {
          "info": {

            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Get GPS position (latitude, longitude, altitude)."
        },
        {
          "info": {
            "name": "Viam Movement Sensor Get Linear Velocity",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.viam.com/viam.component.movementsensor.v1.MovementSensorService/GetLinearVelocity",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Get linear velocity in m/s."
        },
        {
          "info": {
            "name": "Viam Movement Sensor Get Angular Velocity",
            "type": "http"

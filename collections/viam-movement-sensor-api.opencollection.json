        },
        {
          "info": {
            "name": "Viam Movement Sensor Get Orientation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.viam.com/viam.component.movementsensor.v1.MovementSensorService/GetOrientation",
            "body": {
              "type": "json",
              "data": "{}"
            }
